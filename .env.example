# Copy this file to .env and fill in your values. Restart the server afterwards.
# Never share .env: it holds your WhatsApp access token.

# ---- WhatsApp Business Platform (Meta Cloud API) ----
# Leave WA_TOKEN or WA_PHONE_NUMBER_ID empty to stay in test mode (messages are only logged).
WA_TOKEN=
WA_PHONE_NUMBER_ID=
# Name and language of your approved message template (see WHATSAPP_SETUP.md)
WA_TEMPLATE=application_status_update
WA_TEMPLATE_LANG=en
# Set to off to stop all automatic WhatsApp updates
WA_NOTIFY=on

# ---- Automatic status checks ----
CHECK_TIMES=09:00,13:00,17:00,21:00
CHECK_GAP_SECONDS=5

# ---- Database ----
# Use letters and numbers only in the password.
DATABASE_URL=postgres://crm:YOUR_PASSWORD@localhost:5432/crm

# ---- Tunnel ----
# Set these on a computer that is reached through Cloudflare Tunnel.
# HOST=127.0.0.1 hides the site from the local network, so only the tunnel can reach it.
# BEHIND_TUNNEL=on tells visitors apart for the limits on wrong tries.
# HOST=127.0.0.1
BEHIND_TUNNEL=off

# ---- e-PAN emails (optional) ----
# A mailbox that receives only UTIITSL's e-PAN emails. See README.md, "e-PAN emails".
# EPAN_USER is the CRM user ID whose PAN customers get updated.
EPAN_EMAIL=
EPAN_APP_PASSWORD=
EPAN_USER=
EPAN_CHECK_MINUTES=5

# ---- Aadhaar numbers ----
# Encrypts full Aadhaar numbers. Create it with: node create-aadhaar-key.js
# If this key is lost, saved numbers can't be read. Keep a private copy.
AADHAAR_KEY=

# ---- Logins ----
# Set to on when the site is served over https, so login cookies are https only
COOKIE_SECURE=off
# The address people use to open this site. Password reset emails link here,
# so a localhost address only works on this computer. sitemap.xml uses it too.
APP_URL=http://localhost:3000

# Subscriptions: where shops pay. Your UPI ID (shown with a copy button and an
# "Open UPI app" link) and the name shown to shops. To show your QR code too, save
# the QR image from GPay / PhonePe / your bank app as data/upi-qr.png.
UPI_ID=
UPI_NAME=Palaniyandavar Info Tech
# Only once GST-registered: receipts then become tax invoices with this number.
GSTIN=

# ---- On the shop network (the laptop setup fills these in) ----
# Web ports. The laptop uses 80 and 443, so the address needs no :3000.
# PORT=3000
# HTTPS_PORT=3443
# The laptop's name on the network; the HTTPS certificate includes it.
# LAN_NAME=ethunaivan.local
