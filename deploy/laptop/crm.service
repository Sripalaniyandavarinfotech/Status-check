[Unit]
Description=eThunaivan CRM
After=network-online.target postgresql.service avahi-daemon.service
Wants=network-online.target postgresql.service

[Service]
User=crm
Group=crm
WorkingDirectory=/opt/crm
# Remakes the site's HTTPS certificate for the laptop's current Wi-Fi address and
# its name (ethunaivan.local). The certificate authority stays, so devices that
# trusted it once keep trusting it. A failure here never stops the site.
ExecStartPre=-/usr/local/bin/node /opt/crm/create-https-cert.js
ExecStart=/usr/local/bin/node server.js
Restart=always
RestartSec=5
# The normal web ports (80 and 443), so the address needs no :3000.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
